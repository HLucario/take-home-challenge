{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "noEmit": true,
    "types": ["node"]
  },
  "include": ["playwright.config.ts", "config/**/*.ts", "locators/**/*.ts", "pages/**/*.ts", "fixtures/**/*.ts", "utils/**/*.ts", "tests/**/*.ts", "test-data/**/*.json"]
}
